# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Add http://127.0.0.1:8000/auth/callback as a Redirect URI (dev)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# ── Ticketmaster ──────────────────────────────────────────────────────────────
# Register at https://developer-acct.ticketmaster.com
TICKETMASTER_API_KEY=your_ticketmaster_api_key

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase connection string — Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_string

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of dashboard page — used as post-OAuth redirect target
FRONTEND_URL=http://127.0.0.1:3000/dashboard.html
# Set to "production" on Render to enable secure JWT flags
ENVIRONMENT=development
